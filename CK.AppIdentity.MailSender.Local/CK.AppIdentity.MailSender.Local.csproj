<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>The Local side of the "MailSender" feature: this application sends the mails of its remotes with its own mail configuration (CK.Mailer).</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CK.AppIdentity.Cris" Version="3.0.0-0.uc.0.ci.267" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CK.IO.MailSender\CK.IO.MailSender.csproj" />
    <ProjectReference Include="..\CK.Mailer\CK.Mailer.csproj" />
    <!-- The Local side requires the Remote side: the "MailSenderRemote" key of a remote is read by both sides. -->
    <ProjectReference Include="..\CK.AppIdentity.MailSender.Remote\CK.AppIdentity.MailSender.Remote.csproj" />
  </ItemGroup>
</Project>
